/* pages/login/login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90D9 0%, #6BA5E7 50%, #f5f5f5 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 80rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 30rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90D9;
}

.app-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.app-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 通用卡片样式 */
.card {
  background: #ffffff;
  border-radius: 30rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.08);
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 30rpx;
  display: block;
}

/* 角色选择卡片 */
.role-card {
  margin-bottom: 30rpx;
}

.role-options {
  display: flex;
  gap: 30rpx;
  justify-content: center;
}

.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 20rpx;
  background: #f8f9fb;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.role-item:active {
  background: #f0f3f6;
  transform: scale(0.98);
}

.role-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.role-desc {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
}

/* 登录步骤二容器 */
.login-step-2 {
  width: 100%;
}

/* 当前身份提示 */
.role-display-title {
  margin-bottom: 30rpx;
  text-align: center;
}

.role-display-title text {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.input-group {
  display: flex;
  align-items: center;
  background: #f8f9fb;
  border: 2rpx solid #eeeeee;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  transition: all 0.2s ease;
}

.input-group:focus-within {
  border-color: #4A90D9;
  background: #ffffff;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.login-input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.picker-input {
  width: 100%;
}

.picker-display {
  width: 100%;
  color: #333333;
}

.picker-display.placeholder {
  color: #999999;
}

/* 辅助操作区域 */
.action-links {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 30rpx;
  padding: 0 10rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 20rpx 0;
  border-radius: 50rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.3);
}

.action-btn text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* 登录按钮 */
.login-btn-container {
  margin-top: 50rpx;
  padding: 0 20rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 50rpx;
  background: #ffffff !important;
  color: #4A90D9 !important;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.login-btn[disabled] {
  background: rgba(255, 255, 255, 0.6) !important;
  color: rgba(74, 144, 217, 0.5) !important;
}

/* 底部文字 */
.footer-text {
  margin-top: auto;
  padding-top: 60rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}
