/* pages/login/login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90D9 0%, #6BA5E7 50%, #f5f5f5 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 80rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 30rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90D9;
}

.app-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.app-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 卡片标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 30rpx;
  display: block;
}

/* 角色选择卡片 */
.role-card {
  margin-bottom: 30rpx;
}

.role-options {
  display: flex;
  gap: 24rpx;
}

.role-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 20rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.role-item.active {
  background: linear-gradient(135deg, rgba(74, 144, 217, 0.1) 0%, rgba(107, 165, 231, 0.1) 100%);
  border-color: var(--primary-color);
}

.role-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
}

/* 老师选择卡片 */
.teacher-select-card {
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
}

.picker-value {
  font-size: 30rpx;
  color: var(--text-primary);
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 登录按钮 */
.login-btn-container {
  margin-top: 50rpx;
  padding: 0 20rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.login-btn[disabled] {
  background: #cccccc !important;
  color: #ffffff !important;
}

/* 底部文字 */
.footer-text {
  margin-top: auto;
  padding-top: 60rpx;
  text-align: center;
  color: var(--text-hint);
  font-size: 24rpx;
}
