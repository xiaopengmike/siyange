<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-icon">
      <text class="logo-text">思研阁</text>
    </view>
    <text class="app-title">老师排课系统</text>
    <text class="app-subtitle">高效管理您的课程安排</text>
  </view>

  <!-- 角色选择卡片 -->
  <view class="card role-card" wx:if="{{!selectedRole}}">
    <text class="card-title">选择您的角色</text>
    
    <view class="role-options">
      <view 
        class="role-item"
        bindtap="selectRole"
        data-role="teacher"
      >
        <view class="role-icon teacher-icon">👨‍🏫</view>
        <text class="role-name">老师</text>
        <text class="role-desc">管理课程</text>
      </view>

      <view 
        class="role-item"
        bindtap="selectRole"
        data-role="student"
      >
        <view class="role-icon student-icon">👫</view>
        <text class="role-name">家长/学生</text>
        <text class="role-desc">查看课程</text>
      </view>
    </view>
  </view>

  <!-- 登录信息输入 -->
  <view class="login-step-2" wx:if="{{selectedRole}}">
    <view class="role-display-title">
        <text>当前角色：{{selectedRole === 'teacher' ? '老师' : '家长/学生'}}</text>
    </view>
    <view class="card login-form-card">
        <text class="card-title">登录信息</text>
        
        <view class="input-group">
        <view class="input-icon">📱</view>
        <input 
            class="login-input" 
            placeholder="请输入账号" 
            type="number"
            value="{{account}}"
            bindinput="onAccountInput"
        />
        </view>

        <view class="input-group">
        <view class="input-icon">🔒</view>
        <input 
            class="login-input" 
            placeholder="请输入密码" 
            password
            value="{{password}}"
            bindinput="onPasswordInput"
        />
        </view>
    </view>

    <!-- 辅助操作 -->
    <view class="action-links">
        <view class="action-btn back-btn" bindtap="resetRole">
            <text class="action-icon">↺</text>
            <text>重新选择角色</text>
        </view>
        <view class="action-btn register-btn" bindtap="onGoToRegister">
            <text class="action-icon">✚</text>
            <text>注册账号</text>
        </view>
    </view>
  </view>

  <!-- 登录按钮 -->
  <view class="login-btn-container">
    <button 
      class="btn btn-primary login-btn" 
      bindtap="handleLogin"
      disabled="{{!canLogin}}"
    >
      进入系统
    </button>
  </view>

  <!-- 底部说明 -->
  <view class="footer-text">
    <text>思研阁教育科技</text>
  </view>
</view>
