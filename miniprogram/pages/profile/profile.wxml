<!--pages/profile/profile.wxml-->
<view class="container profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar" style="background: linear-gradient(135deg, {{currentUser.color || '#4A90D9'}}, {{currentUser.color || '#357ABD'}})">
      <text class="avatar-text">{{currentUser.name[0]}}</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{currentUser.name}}</text>
      <view class="user-role {{isPrincipal ? 'principal' : 'teacher'}}">
        <text>{{isPrincipal ? '👑 校长' : '👨‍🏫 老师'}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-title">设置</view>
    
    <view class="menu-list">
      <view class="menu-item" bindtap="onSwitchRole">
        <text class="menu-icon">🔄</text>
        <text class="menu-text">切换身份</text>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="onHelp">
        <text class="menu-icon">❓</text>
        <text class="menu-text">使用帮助</text>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="onAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <!-- 底部版本号 -->
  <view class="footer">
    <text class="version">思研阁排课系统 v{{version}}</text>
  </view>
</view>
