/* pages/course-edit/course-edit.wxss */

.edit-container {
  padding: 30rpx;
  padding-bottom: 60rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #eeeeee;
  padding-bottom: 20rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.teacher-tag {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.time-edit-row {
  align-items: flex-start !important;
  flex-direction: column;
  gap: 16rpx;
}

.time-pickers {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.picker-group {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  border: 1rpx solid #eeeeee;
}

.hour-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90D9;
}

.minute-picker {
  font-size: 32rpx;
  font-weight: bold;
  color: #4A90D9;
  padding: 0 10rpx;
}

.duration-group {
  display: flex;
  gap: 20rpx;
}

.radio-label {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.radio-label.active {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
  border-color: #4A90D9;
  font-weight: 500;
}

/* 输入组 */
.input-group {
  margin-bottom: 30rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.label-row .input-label {
  margin-bottom: 0;
}

.required {
  color: #ff4d4f;
}

.add-link {
  font-size: 26rpx;
  color: #4A90D9;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 学生选择器 */
.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.picker-field.placeholder {
  color: #999;
}

.picker-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.student-color {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.student-name {
  font-size: 30rpx;
  color: #333;
  margin-right: 16rpx;
}

.student-phone {
  font-size: 24rpx;
  color: #999;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.no-student-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.link {
  color: #4A90D9;
}

/* 按钮区域 */
.btn-area {
  margin-top: 40rpx;
  padding: 0 10rpx;
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff;
}

.btn-danger {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
}

.mb-30 {
  margin-bottom: 30rpx;
}
